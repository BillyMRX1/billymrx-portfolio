# EmailJS (https://www.emailjs.com/) credentials, from your EmailJS dashboard.
# These are NEXT_PUBLIC_* because the EmailJS browser SDK sends email directly
# from the client; they are meant to be public and end up in the built JS bundle.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
